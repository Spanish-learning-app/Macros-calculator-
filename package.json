{
  "name": "katori",
  "version": "0.1.0",
  "private": true,
  "description": "Katori: your daily meal & macro planner that knows desi food.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "npm link playwright",
    "serve": "http-server app -p 4173 -c-1",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node --test \"tests/{contract,unit,data}/**/*.test.js\"",
    "test": "TZ=Europe/Madrid npm run -s test:unit && TZ=Asia/Karachi npm run -s test:unit && TZ=America/Los_Angeles npm run -s test:unit",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"app/core/**\" --test-coverage-lines=90 \"tests/{contract,unit}/**/*.test.js\"",
    "test:e2e": "playwright test",
    "publish:files": "node scripts/publish-files.mjs",
    "check": "npm run -s lint && npm run -s format:check && npm test",
    "build:single": "npx --yes esbuild@0.24.0 --version >/dev/null && node tools/build-single.mjs"
  }
}
